import numpy as np

MOD, N, HALF = 5, 32, 16
DIM = MOD ** N

CHARGE  = lambda s: (int(np.sum(np.asarray(s)[:HALF]) % MOD),
                     int(np.sum(np.asarray(s)[HALF:]) % MOD))
LAW     = lambda s: sum(CHARGE(s)) % MOD == 0
MIRROR  = lambda s: np.concatenate([np.asarray(s)[HALF:], np.asarray(s)[:HALF]])
SYM     = lambda s: np.array_equal(np.asarray(s), MIRROR(s))
CODE    = lambda s: LAW(s) and SYM(s)

WEIGHT  = lambda s: int(np.count_nonzero(np.asarray(s)))
ENUM    = lambda S: {w: sum(1 for s in S if WEIGHT(s) == w)
                     for w in sorted({WEIGHT(s) for s in S})}

L_LOCAL = np.zeros((MOD, MOD), dtype=complex)
L_LOCAL[0, 2] = 1.0
L_LOCAL[1, 3] = 1.0
L_LOCAL[0, 4] = 1.0

JUMPS   = lambda r: [np.sqrt(r) * L_LOCAL]
L_HEAL  = lambda r: JUMPS(r)[0]

KERNEL  = lambda L: np.linalg.svd(L)[2][np.sum(np.linalg.svd(L)[1] > 1e-8):].conj().T
DARK    = KERNEL(L_LOCAL)

LINDBLAD = lambda rho, H, L, r: (
    -1j * (H @ rho - rho @ H)
    + r * (L @ rho @ L.conj().T - 0.5 * (L.conj().T @ L @ rho + rho @ L.conj().T @ L))
)

STEADY = lambda H, L, r, dt, tol, iters: (
    lambda step, rho, i: (
        rho if np.linalg.norm(LINDBLAD(rho, H, L, r)) < tol or i >= iters
        else step(step, (rho + dt * LINDBLAD(rho, H, L, r)) / np.trace(rho + dt * LINDBLAD(rho, H, L, r)).real, i + 1)
    )
)(lambda step, rho, i: step(step, rho, i), np.eye(MOD, dtype=complex) / MOD, 0)
